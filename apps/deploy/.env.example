# ============================================================
# ifthe :: shared environment
# ------------------------------------------------------------
# 1. Copy this file to ".env"  (cp .env.example .env)
# 2. Fill in every BLANK value below.
# 3. NEVER commit .env to git (the included .gitignore blocks it).
#
# Generate strong secrets with:   openssl rand -base64 48
# ============================================================

# Where ALL app data lives. MUST be on the box's LOCAL disk (never SMB/NFS) AND on a path
# the container runtime actually mounts into containers.
#   your home server runs COLIMA, which mounts $HOME writable by DEFAULT but NOT /Users/Shared.
#     - Simplest (works out of the box): a path under your home, e.g.
#           DATA_ROOT=/Users/you/ifthe
#     - To use /Users/Shared instead, add a Colima mount FIRST (see colima.example.yaml):
#           colima start --edit   # add:  - location: /Users/Shared   writable: true
#   Docker Desktop (other Macs): /Users/Shared/ifthe, then add it under
#       Settings > Resources > File sharing.
#   Linux: /srv/ifthe.
DATA_ROOT=/Users/Shared/ifthe

# Timezone (used by every service for due-dates, OCR timestamps, logs)
TZ=UTC

# Host user that should own the bind-mounted files.
# Find yours with:  id -u   and   id -g
PUID=1000
PGID=1000

# ------------------------------------------------------------
# Vaultwarden (password manager)
# ------------------------------------------------------------
# Generate the Argon2 admin token (you'll be prompted for a password):
#   docker run --rm -it vaultwarden/server /vaultwarden hash
# Paste the FULL $argon2id$... string below, wrapped in single quotes.
VW_ADMIN_TOKEN=
# Vaultwarden MUST be reached over HTTPS for the apps/extensions to connect.
# Easiest: put it behind Tailscale Serve and use your tailnet URL here.
VW_DOMAIN=https://your-box.your-tailnet.ts.net
# Flip to "true" ONLY long enough to register your accounts, then back to "false"
# and re-run `up -d`.
SIGNUPS_ALLOWED=false

# ------------------------------------------------------------
# Paperless-ngx (document archive / OCR)
# ------------------------------------------------------------
PAPERLESS_DB_PASS=
PAPERLESS_SECRET_KEY=
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=
# The URL you'll actually open Paperless at (CSRF/trusted origin):
PAPERLESS_URL=http://home.local:8000

# ------------------------------------------------------------
# Nextcloud (files / calendar / tasks / contacts / photos)
# ------------------------------------------------------------
NEXTCLOUD_DB_ROOT_PASS=
NEXTCLOUD_DB_PASS=
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=
# Space-separated list of hostnames you'll open Nextcloud at.
# Add your tailnet name too, e.g. "your-box.your-tailnet.ts.net".
NEXTCLOUD_TRUSTED_DOMAINS=home.local home localhost

# ------------------------------------------------------------
# Mealie (meal planning): must match the URL you open it at
# ------------------------------------------------------------
MEALIE_URL=http://home.local:9925

# ------------------------------------------------------------
# Homebox (home inventory)
# ------------------------------------------------------------
# Leave "true" to create your first user, then set "false" and re-run `up -d`.
HOMEBOX_ALLOW_REGISTRATION=true

# ============================================================
# AI stack (docker-compose.ai.yml): OPTIONAL, strictly read-only exporters
# ------------------------------------------------------------
# Actual exporter. From a container, reach Actual on the host via
# host.docker.internal (Docker Desktop) or the LAN name home.local.
ACTUAL_SERVER_URL=https://host.docker.internal:5006
ACTUAL_SERVER_PASS=
# The Sync ID shown in Actual → Settings (Advanced → "Sync ID").
ACTUAL_BUDGET_ID=
# Seconds between exports (86400 = daily).
EXPORT_INTERVAL=86400

# Email ingester (Gmail bills/receipts -> Paperless + parsed JSON).
# Host dir holding your getmailrc + Maildir (see scripts/email-ingester/README.md).
# The getmailrc [destination] path MUST be /maildir/inbox/ inside the container.
EMAIL_CONFIG_DIR=/Users/Shared/ifthe/getmail
# Seconds between fetch+parse cycles (1800 = 30 min).
INGEST_INTERVAL=1800

# ============================================================
# Dashboard stack (docker-compose.dashboard.yml): app index + sleep screen
# ------------------------------------------------------------
# Glance app index -> http://home.local:8085 ; front door / sleep screen -> :8086
# Read-only agenda exporter (OPTIONAL): Nextcloud CalDAV -> dashboard/agenda.json.
# App password: Nextcloud → Settings → Security → Create new app password.
NEXTCLOUD_CALDAV_URL=https://home.local:8081/remote.php/dav
NEXTCLOUD_CALDAV_USER=admin
NEXTCLOUD_CALDAV_APP_PASSWORD=
AGENDA_INTERVAL=900
